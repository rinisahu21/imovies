{
  "name": "imovies",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"client/*.js\" \"client/*.cjs\" \"server/src/**/*.js\" \"package.json\" \"client/package.json\" \"server/package.json\"",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx,css}\" \"client/*.js\" \"client/*.cjs\" \"server/src/**/*.js\" \"package.json\" \"client/package.json\" \"server/package.json\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.9.10"
  }
}
